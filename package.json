{
  "name": "porfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "node scripts/check-config-integrity.mjs && next dev",
    "build": "node scripts/check-config-integrity.mjs && node scripts/check-server-tool-env.mjs && vitest run && next build",
    "build:only": "node scripts/check-config-integrity.mjs && node scripts/check-server-tool-env.mjs && next build",
    "start": "next start",
    "lint": "node scripts/check-config-integrity.mjs && next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "budget": "node scripts/check-bundle-budget.mjs",
    "lighthouse:config": "tsx scripts/lighthouse-config.ts",
    "lighthouse": "pnpm lighthouse:config && pnpm dlx @lhci/cli@0.14.0 autorun --config=lighthouserc.generated.json",
    "verify": "node scripts/check-config-integrity.mjs && node scripts/check-server-tool-env.mjs && pnpm typecheck && pnpm lint && pnpm test && pnpm build:only && pnpm budget",
    "validate:registry": "vitest run src/lib/tools/validate.test.ts src/lib/tools/registry.test.ts",
    "test:browser": "playwright test",
    "integrity": "node scripts/check-config-integrity.mjs",
    "routes": "tsx scripts/generate-tool-routes.ts",
    "digest:fetch": "node scripts/check-config-integrity.mjs && NODE_USE_ENV_PROXY=1 tsx scripts/digest/fetch.ts",
    "digest:check": "tsx scripts/digest/check.ts"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jxl": "1.3.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "lenis": "1.3.23",
    "lucide-react": "^0.395.0",
    "motion": "^12.7.4",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "rough-notation": "0.5.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "uqr": "0.1.3",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.17.30",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.11",
    "typescript": "^5.8.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9"
  }
}
