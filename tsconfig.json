{
  "compilerOptions": {
    // Without an explicit target TypeScript assumes ES5, which rejects
    // iteration over strings and Maps and misreports what this codebase can
    // actually use. Emit is Next/SWC's job (driven by browserslist), so this
    // only governs type-checking semantics — and Node 22 plus every browser
    // Next targets support ES2022 comfortably.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@db": ["./db"],
      "@db/*": ["./db/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
