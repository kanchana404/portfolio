# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files: every .env variant, except a committed example
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
/test-results
/playwright-report
/blob-report
/playwright/.cache
.lighthouseci
# Generated from the registry by scripts/lighthouse-config.ts on every run.
lighthouserc.generated.json

# Python virtualenvs (services/downloader)
.venv/
**/.venv/
__pycache__/
*.pyc
.pytest_cache/

# Not part of this repo. downloader-api/ is its own git repository (git add -A
# would record it as an embedded gitlink); design-md/ is a local reference
# folder; .playwright-mcp/ is tool output.
/downloader-api/
/design-md/
/.playwright-mcp/

# Private working notes that must not reach the public repo.
/docs/tools-audit-*.md

# Source images belong outside the repo (../portfolio-originals). Anchored to
# the root, so public/ is unaffected.
/*.png
/*.jpg
/*.jpeg
/*.JPG

# Weekly digest working files: third-party feed text fetched by
# `pnpm digest:fetch` (in Codex Cloud or on a laptop). Untrusted, and never
# committed or deployed.
/.digest/
